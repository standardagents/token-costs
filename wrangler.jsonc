{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "token-costs",
  "main": "worker/index.js",
  "compatibility_date": "2026-05-08",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "run_worker_first": [
      "/",
      "/api/*",
      "/og-image.png"
    ]
  },
  "r2_buckets": [
    {
      "binding": "OG_IMAGES",
      "bucket_name": "are-tokens-getting-cheaper-og"
    }
  ]
  // Required secret (set with: wrangler secret put WAITLIST_API_TOKEN):
  // WAITLIST_API_TOKEN — bearer token for the Standard Agents waitlist API
}
